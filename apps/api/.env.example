# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Deepgram (speech-to-text)
DEEPGRAM_API_KEY=

# Anthropic (Claude — evaluator synthesis)
ANTHROPIC_API_KEY=

# Neon Postgres — use the *pooled* endpoint (host contains "-pooler") and the
# postgresql+asyncpg:// scheme. Do NOT include ?sslmode=require — that's a
# libpq/psycopg2 query param; asyncpg uses ssl="require" passed via connect_args
# (already set in app/db.py). Plain URL only.
DATABASE_URL=

# Sentry (error monitoring) — optional. When unset, `sentry_sdk.init` is a
# no-op. Get a DSN at sentry.io → create a Python/FastAPI project.
SENTRY_DSN=

# Clerk (authentication). CLERK_SECRET_KEY is the "Secret key" from the Clerk
# dashboard → API Keys (starts with sk_test_ / sk_live_). The backend uses it
# only to verify session tokens — never to sign anything.
CLERK_SECRET_KEY=
# Comma-separated frontend origins a token is allowed to come from. Add the
# Vercel domain in production.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Stripe (billing). Use a restricted key (rk_test_ / rk_live_) with write access
# to Customers, Checkout Sessions and Customer portal, and read access to
# Prices and Subscriptions. STRIPE_WEBHOOK_SECRET is the whsec_ value from
# `stripe listen` (dev) or the webhook endpoint in the dashboard (prod).
# Unset → the /billing routes return 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Stripe Checkout / the billing portal send users back to.
WEB_BASE_URL=http://localhost:3000
