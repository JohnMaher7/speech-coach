# Copy this file to .env (or set these in Modal/Vercel env vars in production).
# Real values never get committed — .env is in .gitignore.

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Speech-to-text ---
DEEPGRAM_API_KEY=...

# --- Cloudflare R2 (S3-compatible audio storage) ---
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=toastmasters-audio

# --- Neon Postgres (reports DB) ---
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# --- Frontend ---
# Public Modal URL of the FastAPI backend, exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
